<Window x:Class="VB7x64.IDE.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acerca de VB7-x64 IDE"
        Height="360" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F0F0F0">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="VB7-x64 IDE" FontSize="20" FontWeight="Bold" Foreground="#003399"/>
            <TextBlock Text="Entorno de Desarrollo para Proyectos VB6 Clásicos en Windows x64" FontSize="12" Foreground="#555555" Margin="0,4,0,0"/>
            <TextBlock Text="Versión 1.0 — MVP" FontSize="11" Foreground="#777777" Margin="0,2,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel TextBlock.FontSize="11.5">
                    <TextBlock Text="Detalles del Sistema:" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock x:Name="TxtPlatform" Text="Plataforma: Windows x64 Nativo" Margin="4,2"/>
                    <TextBlock x:Name="TxtRuntime" Text="Runtime: .NET 10 LTS" Margin="4,2"/>
                    <TextBlock x:Name="TxtEditor" Text="Motor de Edición: AvalonEdit (Licencia MIT)" Margin="4,2"/>
                    
                    <Separator Margin="0,10,0,10"/>
                    <TextBlock Text="Características del MVP:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock Text="• Apertura y navegación segura de proyectos .vbp" Margin="4,2"/>
                    <TextBlock Text="• Edición no destructiva de código .frm, .bas y .cls" Margin="4,2"/>
                    <TextBlock Text="• Preservación estricta de ANSI, CRLF y binarios .frx" Margin="4,2"/>
                    <TextBlock Text="• Arquitectura desacoplada de compilador y runtime" Margin="4,2"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Aceptar" Width="85" Height="26" Click="BtnOk_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
