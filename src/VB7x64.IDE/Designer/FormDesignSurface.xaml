<UserControl x:Class="VB7x64.IDE.Designer.FormDesignSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VB7x64.IDE.Designer"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="#4A4D51">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Barra de herramientas del diseñador -->
        <Border Grid.Row="0" Background="#F1F3F5" BorderBrush="#D0D4D9" BorderThickness="0,0,0,1" Padding="6,3">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Botón para alternar a vista de código -->
                    <Button x:Name="BtnSwitchToCode" ToolTip="Ver Código de este componente (F7)" 
                            Padding="6,2" Margin="0,0,6,0" FontSize="11" Click="BtnSwitchToCode_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📜" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock Text="Código"/>
                        </StackPanel>
                    </Button>

                    <!-- Alternar visualización de cuadrícula -->
                    <ToggleButton x:Name="BtnToggleGrid" IsChecked="True" ToolTip="Mostrar u ocultar cuadrícula de puntos" 
                            Padding="6,2" Margin="0,0,4,0" FontSize="11" Click="BtnToggleGrid_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▦" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock Text="Rejilla"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Alternar ajuste magnético (Snap to Grid) -->
                    <ToggleButton x:Name="BtnToggleSnap" IsChecked="True" ToolTip="Ajustar controles magnéticamente a la cuadrícula" 
                                  Padding="6,2" Margin="0,0,6,0" FontSize="11" Click="BtnToggleSnap_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🧲" Margin="0,0,4,0" FontSize="11"/>
                            <TextBlock Text="Ajustar"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Selector de resolución de rejilla -->
                    <TextBlock Text="Paso:" FontSize="11" Foreground="#555555" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbGridSize" Width="85" Height="22" FontSize="11" SelectionChanged="CmbGridSize_SelectionChanged">
                        <ComboBoxItem Content="4 px (60 tw)"/>
                        <ComboBoxItem Content="8 px (120 tw)" IsSelected="True"/>
                        <ComboBoxItem Content="12 px (180 tw)"/>
                        <ComboBoxItem Content="16 px (240 tw)"/>
                    </ComboBox>
                </StackPanel>

                <!-- Estado del formulario (Nombre y dimensiones) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtFormDimensions" Text="4680 × 3195 twips (312 × 213 px)" 
                               FontSize="11" Foreground="#555555" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>

                <TextBlock x:Name="TxtFormTitle" Text="Diseñador de Formularios" 
                           FontWeight="SemiBold" FontSize="11.5" Foreground="#2B3E50" 
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Área de trabajo con desplazamiento -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#5A5D62">
            <Grid Margin="24">
                <Border x:Name="FormWindowBorder" 
                        Background="#ECE9D8" 
                        BorderBrush="#0A246A" 
                        BorderThickness="3" 
                        HorizontalAlignment="Left" 
                        VerticalAlignment="Top">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="3" Direction="315" Opacity="0.4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="TitleBarRow" Height="26"/> <!-- Barra de título -->
                            <RowDefinition Height="Auto"/> <!-- Área de cliente del formulario -->
                        </Grid.RowDefinitions>

                        <!-- 1. Barra de título de la ventana clásica de VB6 -->
                        <Border x:Name="BorderTitleBar" Grid.Row="0" Background="#0A246A" Padding="4,2,2,2">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="16" Height="14" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0">
                                        <TextBlock Text="_" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                    </Border>
                                    <Border Width="16" Height="14" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1" Margin="0,0,2,0">
                                        <TextBlock Text="□" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Width="16" Height="14" Background="#D4D0C8" BorderBrush="#808080" BorderThickness="1">
                                        <TextBlock Text="✕" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🗔" FontSize="11" Margin="0,0,5,0" Foreground="White"/>
                                    <TextBlock x:Name="TxtFormCaption" Text="Form1" FontSize="11" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- 2. Área cliente del Formulario con rejilla de puntos y controles -->
                        <Border Grid.Row="1" x:Name="FormClientArea" Background="#F0F0F0">
                            <local:DesignGridCanvas x:Name="GridCanvas" Width="312" Height="213"
                                                    Focusable="True"
                                                    MouseLeftButtonDown="GridCanvas_MouseLeftButtonDown"
                                                    MouseMove="GridCanvas_MouseMove"
                                                    MouseLeftButtonUp="GridCanvas_MouseLeftButtonUp"
                                                    KeyDown="GridCanvas_KeyDown">
                                <!-- Rectángulo de selección por área (Rubber-band marquee) -->
                                <Rectangle x:Name="MarqueeRectangle"
                                           Stroke="#0078D7" StrokeThickness="1"
                                           StrokeDashArray="3,3"
                                           Fill="#250078D7"
                                           Visibility="Collapsed"
                                           Panel.ZIndex="998"
                                           IsHitTestVisible="False"/>

                                <!-- Marco con 8 tiradores de dimensionamiento (Sizing Handles) -->
                                <local:DesignerSelectionFrame x:Name="SelectionFrame"
                                                               Panel.ZIndex="999"/>
                            </local:DesignGridCanvas>
                        </Border>
                    </Grid>
                </Border>

                <!-- Tirador de redimensión del Formulario (esquina inferior derecha) -->
                <Thumb x:Name="ThumbResizeCorner" 
                       Width="8" Height="8" 
                       Cursor="SizeNWSE" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       DragDelta="ThumbResizeCorner_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Rectangle Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- Tirador de redimensión derecho (ancho) -->
                <Thumb x:Name="ThumbResizeRight" 
                       Width="8" Height="8" 
                       Cursor="SizeWE" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       DragDelta="ThumbResizeRight_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Rectangle Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>

                <!-- Tirador de redimensión inferior (alto) -->
                <Thumb x:Name="ThumbResizeBottom" 
                       Width="8" Height="8" 
                       Cursor="SizeNS" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       DragDelta="ThumbResizeBottom_DragDelta">
                    <Thumb.Template>
                        <ControlTemplate>
                            <Rectangle Fill="#FFFFFF" Stroke="#000000" StrokeThickness="1"/>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </ScrollViewer>

        <!-- Barra de estado inferior del diseñador -->
        <Border Grid.Row="2" Background="#E9ECEF" BorderBrush="#D0D4D9" BorderThickness="0,1,0,0" Padding="8,2">
            <TextBlock x:Name="TxtDesignerStatus" Text="Listo. Haz clic en un control para inspeccionarlo o doble clic para ver su código." FontSize="10.5" Foreground="#555555"/>
        </Border>
    </Grid>
</UserControl>
