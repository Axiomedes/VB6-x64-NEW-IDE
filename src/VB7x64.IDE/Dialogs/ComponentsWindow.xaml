<Window x:Class="VB7x64.IDE.Dialogs.ComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Componentes"
        Height="490" Width="660"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F4"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="120"/>
        </Grid.ColumnDefinitions>

        <!-- Cabecera de Pestañas -->
        <TabControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0" Background="Transparent" Margin="0,0,0,8">
            <TabItem Header="Controles" IsSelected="True" FontWeight="SemiBold"/>
        </TabControl>

        <!-- Contenido principal: Lista de controles ActiveX con CheckBox -->
        <Border Grid.Row="1" Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2">
            <ListBox x:Name="LstComponents" BorderThickness="0" SelectionMode="Single"
                     SelectionChanged="LstComponents_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2,1">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding DisplayTitle}" VerticalAlignment="Center" FontSize="12"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Botones Laterales -->
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <Button x:Name="BtnOk" Content="Aceptar" Height="26" Margin="0,0,0,8" IsDefault="True" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="Cancelar" Height="26" Margin="0,0,0,8" IsCancel="True" Click="BtnCancel_Click"/>
            <Button x:Name="BtnBrowse" Content="Examinar..." Height="26" Margin="0,0,0,16" Click="BtnBrowse_Click" ToolTip="Seleccionar un archivo .ocx, .tlb o .dll desde el disco"/>
            <Button x:Name="BtnSelectAll" Content="Seleccionar todo" Height="24" Margin="0,0,0,6" Click="BtnSelectAll_Click"/>
            <Button x:Name="BtnDeselectAll" Content="Deseleccionar" Height="24" Click="BtnDeselectAll_Click"/>
        </StackPanel>

        <!-- Panel Inferior de Detalles del Componente Seleccionado -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="8" Background="#EAEAEA" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="65"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Archivo:" FontWeight="Bold" FontSize="11" Foreground="#444444"/>
                <TextBlock x:Name="TxtFilePath" Grid.Row="0" Grid.Column="1" Text="(Ninguno)" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#222222"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Biblioteca:" FontWeight="Bold" FontSize="11" Foreground="#444444" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtLibrary" Grid.Row="1" Grid.Column="1" Text="-" FontSize="11" Foreground="#222222" Margin="0,2,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Controles:" FontWeight="Bold" FontSize="11" Foreground="#444444" Margin="0,2,0,0"/>
                <TextBlock x:Name="TxtControls" Grid.Row="2" Grid.Column="1" Text="-" FontSize="11" Foreground="#004488" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
