<Window x:Class="VB7x64.IDE.Dialogs.HotkeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verificador de Teclas Rápidas (Hotkeys / Aceleradores)"
        Height="540" Width="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F4">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <TextBlock x:Name="TxtHeader" Grid.Row="0" Text="Formulario: Form1.frm" FontSize="13" FontWeight="Bold" Foreground="#004488" Margin="0,0,0,4"/>
        
        <!-- Resumen de Auditoría -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="💡 Resolver Conflictos" Height="26" Padding="10,0" Click="BtnAutoResolve_Click" ToolTip="Asigna letras disponibles a los controles que tienen aceleradores duplicados"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="BadgeConflicts" Background="#FFEBE9" BorderBrush="#CF222E" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtConflictCount" Text="0 conflictos detectados" Foreground="#A40E26" FontWeight="SemiBold" FontSize="11.5"/>
                    </Border>
                    <Border Background="#EAFFEC" BorderBrush="#2DA44E" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="0,0,8,0">
                        <TextBlock x:Name="TxtTotalHotkeys" Text="0 con tecla rápida" Foreground="#1A7F37" FontSize="11.5"/>
                    </Border>
                    <TextBlock x:Name="TxtAvailableLetters" Text="Letras libres: A, B, C..." Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Grilla de Controles y Aceleradores -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2" Margin="0,0,0,10">
            <DataGrid x:Name="DgHotkeys" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA"
                      BorderThickness="0" Background="Transparent" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Estado" Binding="{Binding StatusBadge}" Width="105" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Control" Binding="{Binding ControlName}" Width="140" IsReadOnly="True" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Tipo" Binding="{Binding DisplayType}" Width="110" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Tecla" Binding="{Binding DisplayHotkey}" Width="75" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Caption Original" Binding="{Binding OriginalCaption}" Width="170" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Nuevo Caption (editable)" Binding="{Binding NewCaption, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Botones de Acción -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock Text="* Modifica el 'Nuevo Caption' en la grilla anteponiendo '&amp;' antes de la letra que desees asignar como tecla rápida."
                       FontSize="11" Foreground="#666666" VerticalAlignment="Center" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Aplicar Cambios al Formulario" Width="190" Height="26" Margin="0,0,8,0" IsDefault="True" Click="BtnApply_Click"/>
                <Button Content="Cancelar" Width="80" Height="26" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
