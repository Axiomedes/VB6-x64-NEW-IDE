<Window x:Class="VB7x64.IDE.Dialogs.MakeProjectExeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generar Ejecutable PE32 Nativo (MSVBVM60)"
        Height="510" Width="620"
        MinHeight="490" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F4">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Cabecera -->
            <RowDefinition Height="Auto"/> <!-- Destino del archivo -->
            <RowDefinition Height="*"/>    <!-- Metadatos de Versión -->
            <RowDefinition Height="Auto"/> <!-- Barra Inferior de Acción -->
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Source="{StaticResource Icon_MakeExe}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderProject" Text="Generar Archivo Ejecutable (.EXE)" FontSize="14" FontWeight="Bold" Foreground="#004488"/>
                    <TextBlock Text="Emisor nativo de formato PE32 (x86) con enlace canónico a MSVBVM60.DLL sin dependencias externas." FontSize="11" Foreground="#555555" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Destino del Archivo -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Ruta y nombre del archivo ejecutable de destino:" FontWeight="SemiBold" FontSize="11.5" Foreground="#333333" Margin="0,0,0,6"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtOutputPath" Grid.Column="0" Height="26" VerticalContentAlignment="Center" Padding="4,0" FontSize="12"/>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Examinar..." Width="85" Height="26" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Metadatos y Versión -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Propiedades de la Versión y Metadatos del Proyecto:" FontWeight="SemiBold" FontSize="11.5" Foreground="#333333" Margin="0,0,0,8"/>

                    <!-- Título -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Título de la aplicación:" VerticalAlignment="Center" FontSize="11.5" Foreground="#555555"/>
                        <TextBox x:Name="TxtTitle" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" FontSize="11.5"/>
                    </Grid>

                    <!-- Versión Mayor, Menor, Revisión -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Número de versión:" VerticalAlignment="Center" FontSize="11.5" Foreground="#555555"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Mayor:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" Foreground="#666666"/>
                            <TextBox x:Name="TxtMajor" Width="45" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="1" Margin="0,0,10,0"/>

                            <TextBlock Text="Menor:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" Foreground="#666666"/>
                            <TextBox x:Name="TxtMinor" Width="45" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="0" Margin="0,0,10,0"/>

                            <TextBlock Text="Revisión:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0" Foreground="#666666"/>
                            <TextBox x:Name="TxtRevision" Width="55" Height="24" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="0" Margin="0,0,14,0"/>

                            <CheckBox x:Name="ChkAutoIncrement" Content="Auto-incrementar revisión" VerticalAlignment="Center" FontSize="11" Foreground="#444444"/>
                        </StackPanel>
                    </Grid>

                    <Separator Margin="0,4,0,8" Background="#E0E0E0"/>

                    <!-- Descripción -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Descripción del archivo:" VerticalAlignment="Center" FontSize="11.5" Foreground="#555555"/>
                        <TextBox x:Name="TxtDescription" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" FontSize="11.5"/>
                    </Grid>

                    <!-- Compañía -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nombre de la compañía:" VerticalAlignment="Center" FontSize="11.5" Foreground="#555555"/>
                        <TextBox x:Name="TxtCompany" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" FontSize="11.5"/>
                    </Grid>

                    <!-- Copyright -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Copyright legal:" VerticalAlignment="Center" FontSize="11.5" Foreground="#555555"/>
                        <TextBox x:Name="TxtCopyright" Grid.Column="1" Height="24" VerticalContentAlignment="Center" Padding="4,0" FontSize="11.5"/>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Barra Inferior -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" DockPanel.Dock="Left">
                <Border Background="#E6F4EA" BorderBrush="#137333" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                    <TextBlock Text="x86 / PE32" FontSize="10.5" FontWeight="Bold" Foreground="#137333"/>
                </Border>
                <TextBlock Text="Target: MSVBVM60.DLL (Nativo Windows)" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnGenerate" Content="⚙️ Generar" Width="105" Height="28" Margin="0,0,8,0" FontWeight="SemiBold" IsDefault="True" Click="BtnGenerate_Click"/>
                <Button x:Name="BtnCancel" Content="Cancelar" Width="85" Height="28" IsCancel="True" Click="BtnCancel_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
