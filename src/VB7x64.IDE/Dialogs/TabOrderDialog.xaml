<Window x:Class="VB7x64.IDE.Dialogs.TabOrderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diseñador de Orden de Tabulación (Tab Order)"
        Height="540" Width="780"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F4">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <TextBlock x:Name="TxtHeader" Grid.Row="0" Text="Formulario: Form1.frm" FontSize="13" FontWeight="Bold" Foreground="#004488" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="1" Text="Reordena los controles para definir la secuencia de foco al presionar Tab:" FontSize="11.5" Foreground="#555555" Margin="0,0,0,8"/>

        <!-- Contenido principal: Barra de Herramientas + Grilla de Controles -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="130"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid de Controles -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="2">
                <DataGrid x:Name="DgControls" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAEAEA"
                          BorderThickness="0" Background="Transparent" RowHeaderWidth="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tab" Binding="{Binding TabIndex}" Width="50" FontWeight="Bold"/>
                        <DataGridTextColumn Header="Control" Binding="{Binding Name}" Width="150" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Tipo" Binding="{Binding DisplayType}" Width="110"/>
                        <DataGridTextColumn Header="Caption / Texto" Binding="{Binding Caption}" Width="160"/>
                        <DataGridTextColumn Header="TabStop" Binding="{Binding TabStop}" Width="65"/>
                        <DataGridTextColumn Header="Ubicación" Binding="{Binding DisplayCoordinates}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Botones Laterales de Reordenamiento -->
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Button Content="⬆️ Subir" Height="28" Margin="0,0,0,6" Click="BtnMoveUp_Click" ToolTip="Mover el control seleccionado antes en el orden de tabulación"/>
                <Button Content="⬇️ Bajar" Height="28" Margin="0,0,0,12" Click="BtnMoveDown_Click" ToolTip="Mover el control seleccionado después en el orden de tabulación"/>

                <Separator Margin="0,0,0,12"/>

                <Button Content="🧭 Flujo Natural" Height="30" Margin="0,0,0,4" Click="BtnAutoGeographic_Click" ToolTip="Auto-ordenar de arriba hacia abajo y de izquierda a derecha según posición (Top, Left)"/>
                <TextBlock Text="Auto-ordenar por coordenadas (Top ➔ Left)" FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,0,0,12"/>

                <Button Content="🔄 Restaurar" Height="26" Margin="0,0,0,6" Click="BtnReset_Click" ToolTip="Restablecer el orden original"/>
            </StackPanel>
        </Grid>

        <!-- Botones de Acción Inferiores -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <TextBlock x:Name="TxtControlCount" Text="0 controles encontrados" VerticalAlignment="Center" Foreground="#555555" FontSize="11.5" DockPanel.Dock="Left"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Aplicar al Formulario" Width="170" Height="26" Margin="0,0,8,0" IsDefault="True" Click="BtnApply_Click"/>
                <Button Content="Cancelar" Width="80" Height="26" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
