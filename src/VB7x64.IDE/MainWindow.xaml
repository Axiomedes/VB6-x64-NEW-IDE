<Window x:Class="VB7x64.IDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VB7-x64 IDE - Entorno de Desarrollo VB6 Clásico"
        Height="720" Width="1100"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen">
    
    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCurrentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+Shift+S" Command="{Binding SaveAllCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseCurrentCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menú Superior -->
            <RowDefinition Height="Auto"/> <!-- Barra de Herramientas -->
            <RowDefinition Height="*"/>    <!-- Área Principal (Project Explorer + Editor + Output) -->
            <RowDefinition Height="Auto"/> <!-- Barra de Estado -->
        </Grid.RowDefinitions>

        <!-- 1. Menú Superior -->
        <Menu Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="2">
            <MenuItem Header="_Archivo">
                <MenuItem Header="_Nuevo Proyecto..." IsEnabled="False"/>
                <MenuItem Header="_Abrir Proyecto o Grupo..." InputGestureText="Ctrl+O" Click="MenuOpenProject_Click"/>
                <MenuItem Header="Abrir _Archivo..." Click="MenuOpenFile_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuRecentProjects" Header="Proyectos _recientes"/>
                <MenuItem x:Name="MenuRecentFiles" Header="Archivos r_ecientes"/>
                <Separator/>
                <MenuItem x:Name="MenuSave" Header="_Guardar" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Guardar c_omo..." Click="MenuSaveAs_Click"/>
                <MenuItem x:Name="MenuSaveAll" Header="Guardar _todo" InputGestureText="Ctrl+Shift+S" Click="MenuSaveAll_Click"/>
                <MenuItem x:Name="MenuCloseDoc" Header="_Cerrar documento" InputGestureText="Ctrl+W" Click="MenuCloseDoc_Click"/>
                <Separator/>
                <MenuItem Header="_Salir" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edición">
                <MenuItem Header="_Deshacer" InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                <MenuItem Header="_Rehacer" InputGestureText="Ctrl+Y" Click="MenuRedo_Click"/>
                <Separator/>
                <MenuItem Header="Cor_tar" InputGestureText="Ctrl+X" Click="MenuCut_Click"/>
                <MenuItem Header="_Copiar" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                <MenuItem Header="_Pegar" InputGestureText="Ctrl+V" Click="MenuPaste_Click"/>
                <Separator/>
                <MenuItem Header="_Buscar..." InputGestureText="Ctrl+F" Click="MenuFind_Click"/>
                <MenuItem Header="_Reemplazar..." InputGestureText="Ctrl+H" Click="MenuReplace_Click"/>
                <MenuItem Header="Buscar en todo el _proyecto..." InputGestureText="Ctrl+Shift+F" Click="MenuFindInProject_Click"/>
                <MenuItem Header="_Ir a línea..." InputGestureText="Ctrl+G" Click="MenuGoToLine_Click"/>
            </MenuItem>
            <MenuItem Header="_Ver">
                <MenuItem x:Name="MenuToggleProjectExplorer" Header="_Explorador de Proyectos" IsCheckable="True" IsChecked="True" Click="MenuToggleProjectExplorer_Click"/>
                <MenuItem x:Name="MenuExplorerMode" Header="Modo de Explorador: _Avanzado" IsCheckable="True" IsChecked="True" Click="MenuExplorerMode_Click"/>
                <MenuItem x:Name="MenuToggleOutput" Header="Panel de _Salida / Logs" IsCheckable="True" IsChecked="False" Click="MenuToggleOutput_Click"/>
                <MenuItem x:Name="MenuToggleStatusBar" Header="_Barra de Estado" IsCheckable="True" IsChecked="True" Click="MenuToggleStatusBar_Click"/>
                <Separator/>
                <MenuItem Header="Abrir Carpeta de _Logs" Click="MenuOpenLogsFolder_Click"/>
            </MenuItem>
            <MenuItem Header="_Funciones Avanzadas VB7">
                <MenuItem x:Name="MenuToggleLineHighlight" Header="Resaltar _Línea Activa" IsCheckable="True" IsChecked="True" Click="MenuToggleLineHighlight_Click"/>
                <MenuItem x:Name="MenuToggleBranchLines" Header="Guías de _Estructura (Branch Lines)" IsCheckable="True" IsChecked="True" Click="MenuToggleBranchLines_Click"/>
                <MenuItem x:Name="MenuToggleEndOfLineDetails" Header="Detalles de _Fin de Bloque (Inlay Hints)" IsCheckable="True" IsChecked="True" Click="MenuToggleEndOfLineDetails_Click"/>
                <Separator/>
                <MenuItem Header="_Comentar Bloque" InputGestureText="Ctrl+K, Ctrl+C" Click="MenuCommentBlock_Click"/>
                <MenuItem Header="_Descomentar Bloque" InputGestureText="Ctrl+K, Ctrl+U" Click="MenuUncommentBlock_Click"/>
                <MenuItem Header="_Invertir Asignaciones (A = B ⇄ B = A)" InputGestureText="Ctrl+Shift+R" Click="MenuSwitchAssignment_Click"/>
                <Separator/>
                <MenuItem Header="Convertir a _MAYÚSCULAS" Click="MenuCaseUpper_Click"/>
                <MenuItem Header="Convertir a m_inúsculas" Click="MenuCaseLower_Click"/>
                <MenuItem Header="Convertir a Tipo _Título" Click="MenuCaseTitle_Click"/>
            </MenuItem>
            <MenuItem Header="_Herramientas">
                <MenuItem Header="_Opciones..." Click="MenuOptions_Click"/>
            </MenuItem>
            <MenuItem Header="_Ayuda">
                <MenuItem Header="_Acerca de VB7-x64 IDE..." Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. Barra de Herramientas Inicial -->
        <ToolBarTray Grid.Row="1" Background="#F0F0F0">
            <ToolBar Band="0" BandIndex="0">
                <Button ToolTip="Abrir Proyecto o Grupo (Ctrl+O)" Click="MenuOpenProject_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📂" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Abrir Archivo" Click="MenuOpenFile_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnSaveToolbar" ToolTip="Guardar (Ctrl+S)" Click="MenuSave_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💾" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnSaveAllToolbar" ToolTip="Guardar Todo (Ctrl+Shift+S)" Click="MenuSaveAll_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🗄️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button ToolTip="Deshacer (Ctrl+Z)" Click="MenuUndo_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="↩" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Rehacer (Ctrl+Y)" Click="MenuRedo_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="↪" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button ToolTip="Cortar (Ctrl+X)" Click="MenuCut_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="✂" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Copiar (Ctrl+C)" Click="MenuCopy_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Pegar (Ctrl+V)" Click="MenuPaste_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📑" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button ToolTip="Buscar (Ctrl+F)" Click="MenuFind_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Buscar en Todo el Proyecto (Ctrl+Shift+F)" Click="MenuFindInProject_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔎" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </ToolBar>

            <!-- Barra de Herramientas: Funciones Avanzadas VB7 -->
            <ToolBar Band="1" BandIndex="0">
                <Border ToolTip="Funciones Avanzadas VB7" Background="#E6EEF8" CornerRadius="3" Padding="5,2" Margin="0,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontWeight="Bold" FontSize="13" Foreground="#004488"/>
                </Border>
                <Button x:Name="BtnToolbarComment" ToolTip="Comentar Bloque Seleccionado (Ctrl+K, Ctrl+C)" Click="MenuCommentBlock_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💬⁺" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarUncomment" ToolTip="Descomentar Bloque Seleccionado (Ctrl+K, Ctrl+U)" Click="MenuUncommentBlock_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💬⁻" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnToolbarSwitchAssignment" ToolTip="Invertir Asignaciones A = B ⇄ B = A (Ctrl+Shift+R)" Click="MenuSwitchAssignment_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="⇄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <ToggleButton x:Name="BtnToolbarToggleLineHighlight" ToolTip="Alternar Resaltado de Línea Activa" IsChecked="True" Click="BtnToolbarToggleLineHighlight_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnToolbarToggleBranchLines" ToolTip="Alternar Guías de Estructura de Bloques (Branch Lines)" IsChecked="True" Click="BtnToolbarToggleBranchLines_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🌿" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnToolbarToggleEndOfLineDetails" ToolTip="Alternar Detalles de Fin de Bloque (Inlay Hints)" IsChecked="True" Click="BtnToolbarToggleEndOfLineDetails_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🏷️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                <Separator/>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem ToolTip="Cambiar Mayúsculas / Minúsculas" Header="🔤" Padding="4,2" FontSize="13">
                        <MenuItem Header="Convertir a MAYÚSCULAS" Click="MenuCaseUpper_Click"/>
                        <MenuItem Header="Convertir a minúsculas" Click="MenuCaseLower_Click"/>
                        <MenuItem Header="Convertir a Tipo Título" Click="MenuCaseTitle_Click"/>
                    </MenuItem>
                </Menu>
            </ToolBar>
        </ToolBarTray>

        <!-- 3. Área Principal: Panel Lateral + Splitter + Editor + Output Panel -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="RowOutputSplitter" Height="4"/>
                <RowDefinition x:Name="RowOutput" Height="140"/>
            </Grid.RowDefinitions>

            <!-- Área Superior: Explorer + Editor -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColProjectExplorer" Width="260" MinWidth="150" MaxWidth="500"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel de Explorador de Proyectos -->
                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="#E8EEF5" BorderBrush="#C5D3E8" BorderThickness="0,0,0,1" Padding="6,4">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnToggleExplorerMode" ToolTip="Alternar Modo de Explorador (Estándar / Avanzado)" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToggleExplorerMode_Click">
                                        <TextBlock x:Name="TxtExplorerModeIcon" Text="⚡" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="Explorador de Proyectos" FontWeight="SemiBold" FontSize="12" Foreground="#102A45" VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#F4F7FA" BorderBrush="#DCE4EC" BorderThickness="0,0,0,1" Padding="4,3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                <TextBox x:Name="TxtProjectSearch" Grid.Column="1" Height="22" FontSize="11.5" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#C0CAD4" Padding="3,1" ToolTip="Buscar archivos, módulos o procedimientos en tiempo real" TextChanged="TxtProjectSearch_TextChanged"/>
                                <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="18" Height="20" Margin="2,0,0,0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Limpiar búsqueda" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <TreeView x:Name="ProjectTreeView" Grid.Row="2" BorderThickness="0" Padding="4" MouseDoubleClick="ProjectTreeView_MouseDoubleClick">
                            <TreeViewItem Header="Ningún proyecto abierto" IsSelected="True" Foreground="#777777" FontStyle="Italic"/>
                        </TreeView>
                    </Grid>
                </Border>

                <!-- Splitter para redimensionar el panel lateral -->
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

                <!-- Área Central de Pestañas / Documentos -->
                <Border Grid.Column="2" Background="#ECECEC">
                    <Grid>
                        <TabControl x:Name="DocumentsTabControl" BorderThickness="0" Background="#FFFFFF">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="MinHeight" Value="28"/>
                                    <Setter Property="MinWidth" Value="110"/>
                                    <Setter Property="Padding" Value="10,4,8,4"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="TabBorder" BorderThickness="1,1,1,0" BorderBrush="#D0D0D0" 
                                                        Background="#EDEDED" CornerRadius="4,4,0,0" Margin="2,2,2,0" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      RecognizesAccessKey="True" ContentSource="Header"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#007ACC"/>
                                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#F8F8F8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>
                        </TabControl>

                        <!-- Mensaje cuando no hay documentos abiertos -->
                        <Border x:Name="EmptyDocsNotice" Background="#FDFDFD" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="VB7-x64 IDE" FontSize="26" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock Text="Abre un proyecto .vbp / grupo .vbg o archivo de código (.bas, .cls, .frm, .ctl, etc.)" FontSize="13" Foreground="#999999" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <Button Content="Abrir Proyecto / Grupo (.vbp, .vbg)" Padding="10,5" Margin="5" Click="MenuOpenProject_Click"/>
                                    <Button Content="Abrir Archivo de Código VB6" Padding="10,5" Margin="5" Click="MenuOpenFile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter para el Panel Inferior de Salida -->
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeNS"/>

            <!-- Panel Inferior de Salida / Logs -->
            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="6,2">
                        <DockPanel>
                            <TextBlock Text="Salida / Registro de Eventos" FontWeight="SemiBold" FontSize="11.5" Foreground="#333333" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Limpiar" Padding="6,1" FontSize="11" Margin="0,0,4,0" Click="BtnClearOutput_Click"/>
                                <Button Content="✕" Width="18" Height="18" FontSize="10" Padding="0" Click="BtnCloseOutput_Click" ToolTip="Ocultar panel"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBox x:Name="TxtOutputLog" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="#FFFFFF"
                             FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Barra de Estado Inferior -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="3" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="4,2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="TxtStatusMessage" Text="Listo" FontSize="11.5" Foreground="#333333"/>
            </StatusBarItem>
            <Separator Grid.Column="1"/>
            <StatusBarItem Grid.Column="2">
                <TextBlock x:Name="TxtStatusLineCol" Text="Ln 1, Col 1" FontSize="11.5" Foreground="#555555" Margin="6,0"/>
            </StatusBarItem>
            <Separator Grid.Column="3"/>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="TxtStatusEncoding" Text="Windows-1252 (ANSI) | CRLF" FontSize="11.5" Foreground="#555555" Margin="6,0"/>
            </StatusBarItem>
            <Separator Grid.Column="5"/>
            <StatusBarItem Grid.Column="6">
                <TextBlock x:Name="TxtStatusPlatform" Text="Win-x64 | .NET 10" FontSize="11.5" FontWeight="SemiBold" Foreground="#004488" Margin="6,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
