<Window x:Class="VB7x64.IDE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:designer="clr-namespace:VB7x64.IDE.Designer"
        mc:Ignorable="d"
        Title="VB7-x64 IDE - Entorno de Desarrollo VB6 Clásico"
        Height="720" Width="1100"
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="BottomTabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,3,10,3"/>
            <Setter Property="Margin" Value="0,0,2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBd" Background="{TemplateBinding Background}" CornerRadius="3,3,0,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#FFFFFF"/>
                                <Setter TargetName="TabBd" Property="BorderBrush" Value="#007ACC"/>
                                <Setter TargetName="TabBd" Property="BorderThickness" Value="0,2,0,0"/>
                                <Setter Property="Foreground" Value="#007ACC"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBd" Property="Background" Value="#EAEAEA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Menú Superior -->
            <RowDefinition Height="Auto"/> <!-- Barra de Herramientas -->
            <RowDefinition Height="*"/>    <!-- Área Principal (Project Explorer + Editor + Output) -->
            <RowDefinition Height="Auto"/> <!-- Barra de Estado -->
        </Grid.RowDefinitions>

        <!-- 1. Menú Superior -->
        <Menu Grid.Row="0" Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="2">
            <MenuItem Header="_Archivo">
                <MenuItem x:Name="MenuNewProject" Header="_Nuevo Proyecto..." InputGestureText="Ctrl+Shift+N" Click="MenuNewProject_Click"/>
                <MenuItem x:Name="MenuNewForm" Header="_Nuevo Formulario..." InputGestureText="Ctrl+N" Click="MenuNewForm_Click"/>
                <Separator/>
                <MenuItem Header="_Abrir Proyecto o Grupo..." InputGestureText="Ctrl+O" Click="MenuOpenProject_Click"/>
                <MenuItem Header="Abrir _Archivo..." Click="MenuOpenFile_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuRecentProjects" Header="Proyectos _recientes"/>
                <MenuItem x:Name="MenuRecentFiles" Header="Archivos r_ecientes"/>
                <Separator/>
                <MenuItem x:Name="MenuSave" Header="_Guardar" InputGestureText="Ctrl+S" Click="MenuSave_Click"/>
                <MenuItem x:Name="MenuSaveAs" Header="Guardar c_omo..." Click="MenuSaveAs_Click"/>
                <MenuItem x:Name="MenuSaveAll" Header="Guardar _todo" InputGestureText="Ctrl+Shift+S" Click="MenuSaveAll_Click"/>
                <MenuItem x:Name="MenuCloseDoc" Header="_Cerrar documento" InputGestureText="Ctrl+W" Click="MenuCloseDoc_Click"/>
                <MenuItem x:Name="MenuCloseAll" Header="Cerrar _todo (Proyecto y Documentos)" InputGestureText="Ctrl+Shift+W" Click="MenuCloseAll_Click"/>
                <Separator/>
                <MenuItem Header="_Salir" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edición">
                <MenuItem Header="_Deshacer" InputGestureText="Ctrl+Z" Click="MenuUndo_Click"/>
                <MenuItem Header="_Rehacer" InputGestureText="Ctrl+Y" Click="MenuRedo_Click"/>
                <Separator/>
                <MenuItem Header="Cor_tar" InputGestureText="Ctrl+X" Click="MenuCut_Click"/>
                <MenuItem Header="_Copiar" InputGestureText="Ctrl+C" Click="MenuCopy_Click"/>
                <MenuItem Header="_Pegar" InputGestureText="Ctrl+V" Click="MenuPaste_Click"/>
                <Separator/>
                <MenuItem Header="_Buscar..." InputGestureText="Ctrl+F" Click="MenuFind_Click"/>
                <MenuItem Header="_Reemplazar..." InputGestureText="Ctrl+H" Click="MenuReplace_Click"/>
                <MenuItem Header="Buscar en todo el _proyecto..." InputGestureText="Ctrl+Shift+F" Click="MenuFindInProject_Click"/>
                <MenuItem Header="Buscar todas las _referencias..." InputGestureText="Shift+F12" Click="MenuFindReferences_Click"/>
                <MenuItem Header="_Ir a línea..." InputGestureText="Ctrl+G" Click="MenuGoToLine_Click"/>
                <Separator/>
                <MenuItem Header="_Formatear Documento" InputGestureText="Ctrl+K, Ctrl+D" Click="MenuFormatDocument_Click"/>
            </MenuItem>
            <MenuItem Header="_Ver">
                <MenuItem Header="Navegar hacia a_trás" InputGestureText="Alt+←" Click="MenuNavBackward_Click"/>
                <MenuItem Header="Navegar hacia a_delante" InputGestureText="Alt+→" Click="MenuNavForward_Click"/>
                <MenuItem x:Name="MenuViewCode" Header="_Código" InputGestureText="F7" Click="BtnViewCode_Click"/>
                <MenuItem x:Name="MenuViewObject" Header="_Objeto" InputGestureText="Shift+F7" Click="BtnViewObject_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuToggleToolbox" Header="_Caja de Herramientas" IsCheckable="True" IsChecked="True" InputGestureText="Ctrl+Alt+X" Click="MenuToggleToolbox_Click"/>
                <MenuItem x:Name="MenuToggleProjectExplorer" Header="_Explorador de Proyectos" IsCheckable="True" IsChecked="True" Click="MenuToggleProjectExplorer_Click"/>
                <MenuItem x:Name="MenuToggleProperties" Header="Ventana de _Propiedades" IsCheckable="True" IsChecked="True" InputGestureText="F4" Click="MenuToggleProperties_Click"/>
                <MenuItem x:Name="MenuExplorerMode" Header="Modo de Explorador: _Avanzado" IsCheckable="True" IsChecked="True" Click="MenuExplorerMode_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuToggleOutput" Header="Panel de _Salida / Logs" IsCheckable="True" IsChecked="False" Click="MenuToggleOutput_Click"/>
                <MenuItem x:Name="MenuToggleReferences" Header="Panel de _Referencias y Usos" Click="MenuToggleReferences_Click"/>
                <MenuItem x:Name="MenuToggleTasks" Header="Lista de _Tareas (TODO)" Click="MenuToggleTasks_Click"/>
                <MenuItem x:Name="MenuToggleStatusBar" Header="_Barra de Estado" IsCheckable="True" IsChecked="True" Click="MenuToggleStatusBar_Click"/>
                <Separator/>
                <MenuItem Header="Abrir Carpeta de _Logs" Click="MenuOpenLogsFolder_Click"/>
            </MenuItem>
            <MenuItem Header="_Proyecto">
                <MenuItem Header="_Agregar Formulario..." InputGestureText="Ctrl+N" Click="MenuNewForm_Click"/>
                <MenuItem Header="Agregar _Módulo..." Click="MenuAddModule_Click"/>
                <MenuItem Header="Agregar Módulo de _Clase..." Click="MenuAddClass_Click"/>
            </MenuItem>
            <MenuItem Header="_Funciones Avanzadas">
                <MenuItem x:Name="MenuToggleLineHighlight" Header="Resaltar _Línea Activa" IsCheckable="True" IsChecked="True" Click="MenuToggleLineHighlight_Click"/>
                <MenuItem x:Name="MenuToggleBranchLines" Header="Guías de _Estructura (Branch Lines)" IsCheckable="True" IsChecked="True" Click="MenuToggleBranchLines_Click"/>
                <MenuItem x:Name="MenuToggleEndOfLineDetails" Header="Detalles de _Fin de Bloque (Inlay Hints)" IsCheckable="True" IsChecked="True" Click="MenuToggleEndOfLineDetails_Click"/>
                <Separator/>
                <MenuItem Header="_Comentar Bloque" InputGestureText="Ctrl+K, Ctrl+C" Click="MenuCommentBlock_Click"/>
                <MenuItem Header="_Descomentar Bloque" InputGestureText="Ctrl+K, Ctrl+U" Click="MenuUncommentBlock_Click"/>
                <MenuItem Header="_Invertir Asignaciones (A = B ⇄ B = A)" InputGestureText="Ctrl+Shift+R" Click="MenuSwitchAssignment_Click"/>
                <Separator/>
                <MenuItem Header="Convertir a _MAYÚSCULAS" Click="MenuCaseUpper_Click"/>
                <MenuItem Header="Convertir a m_inúsculas" Click="MenuCaseLower_Click"/>
                <MenuItem Header="Convertir a Tipo _Título" Click="MenuCaseTitle_Click"/>
                <Separator/>
                <MenuItem Header="Buscar todas las _Referencias..." InputGestureText="Shift+F12" Click="MenuFindReferences_Click"/>
                <MenuItem Header="Explorador de _Tareas (TODO)..." Click="MenuToggleTasks_Click"/>
                <Separator/>
                <MenuItem Header="_Alternar Marcador" InputGestureText="Ctrl+F2" Click="MenuToggleBookmark_Click"/>
                <MenuItem Header="_Siguiente Marcador" InputGestureText="F2" Click="MenuNextBookmark_Click"/>
                <MenuItem Header="Marcador _Anterior" InputGestureText="Shift+F2" Click="MenuPrevBookmark_Click"/>
                <MenuItem Header="_Borrar Todos los Marcadores" InputGestureText="Ctrl+Shift+F2" Click="MenuClearBookmarks_Click"/>
                <Separator/>
                <MenuItem Header="Asistente de _Propiedades (Property Builder)..." Click="MenuPropertyBuilder_Click"/>
                <MenuItem Header="Asistente de _Procedimientos (Sub / Function Builder)..." Click="MenuProcedureBuilder_Click"/>
                <MenuItem Header="_Insertar Snippet (AutoText)..." Click="MenuInsertSnippet_Click"/>
                <MenuItem Header="_Historial del Portapapeles (Clipboard Ring)..." InputGestureText="Ctrl+Shift+V" Click="MenuClipboardRing_Click"/>
                <Separator/>
                <MenuItem Header="_Formatear Documento" InputGestureText="Ctrl+K, Ctrl+D" Click="MenuFormatDocument_Click"/>
                <MenuItem Header="_Alinear Declaraciones As" Click="MenuAlignDeclarations_Click"/>
                <MenuItem Header="_Ordenar Procedimientos..." Click="MenuSortProcedures_Click"/>
                <Separator/>
                <MenuItem Header="Comparar Diferencias con el _Disco (Diff)..." Click="MenuShowDiff_Click"/>
                <MenuItem Header="_Estadísticas del Código y Proyecto..." Click="MenuCodeStatistics_Click"/>
                <Separator/>
                <MenuItem Header="Gestor de Manejo de _Errores..." Click="MenuErrorHandler_Click"/>
                <MenuItem Header="Inyección de _Trazas (Tracing)..." Click="MenuTracing_Click"/>
                <MenuItem Header="_Retirar Todas las Trazas del Módulo" Click="MenuRemoveTraces_Click"/>
                <Separator/>
                <MenuItem Header="Diseñador de Orden de _Tabulación (Tab Order)..." Click="MenuTabOrder_Click"/>
                <MenuItem Header="Verificador de _Teclas Rápidas (Hotkeys)..." Click="MenuHotkeys_Click"/>
                <MenuItem Header="Ejecutar _Analizador de Calidad de Código..." Click="MenuRunAnalysis_Click"/>
            </MenuItem>
            <MenuItem Header="_Herramientas">
                <MenuItem Header="_Opciones..." Click="MenuOptions_Click"/>
            </MenuItem>
            <MenuItem Header="_Ayuda">
                <MenuItem Header="_Acerca de VB7-x64 IDE..." Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 2. Barra de Herramientas Inicial -->
        <ToolBarTray Grid.Row="1" Background="#F0F0F0">
            <ToolBar Band="0" BandIndex="0">
                <Button ToolTip="Nuevo Proyecto (Ctrl+Shift+N)" Click="MenuNewProject_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="✨" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Nuevo Formulario (Ctrl+N)" Click="MenuNewForm_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🗔" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button ToolTip="Abrir Proyecto o Grupo (Ctrl+O)" Click="MenuOpenProject_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📂" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Abrir Archivo" Click="MenuOpenFile_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnSaveToolbar" ToolTip="Guardar (Ctrl+S)" Click="MenuSave_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💾" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnSaveAllToolbar" ToolTip="Guardar Todo (Ctrl+Shift+S)" Click="MenuSaveAll_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🗄️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnToolbarNavBack" ToolTip="Navegar hacia atrás (Alt+←)" Click="MenuNavBackward_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="◀" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarNavForward" ToolTip="Navegar hacia adelante (Alt+→)" Click="MenuNavForward_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="▶" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button ToolTip="Deshacer (Ctrl+Z)" Click="MenuUndo_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="↩" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Rehacer (Ctrl+Y)" Click="MenuRedo_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="↪" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button ToolTip="Cortar (Ctrl+X)" Click="MenuCut_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="✂" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Copiar (Ctrl+C)" Click="MenuCopy_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📋" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Pegar (Ctrl+V)" Click="MenuPaste_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📑" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button ToolTip="Buscar (Ctrl+F)" Click="MenuFind_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔍" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Buscar en Todo el Proyecto (Ctrl+Shift+F)" Click="MenuFindInProject_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔎" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Buscar Referencias del Símbolo (Shift+F12)" Click="MenuFindReferences_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔎*" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Lista de Tareas (TODO Explorer)" Click="MenuToggleTasks_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📝" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </ToolBar>

            <!-- Barra de Herramientas: Funciones Avanzadas -->
            <ToolBar Band="1" BandIndex="0">
                <Border ToolTip="Funciones Avanzadas" Background="#E6EEF8" CornerRadius="3" Padding="5,2" Margin="0,0,4,0" VerticalAlignment="Center">
                    <TextBlock Text="⚡" FontWeight="Bold" FontSize="13" Foreground="#004488"/>
                </Border>
                <Button x:Name="BtnToolbarComment" ToolTip="Comentar Bloque Seleccionado (Ctrl+K, Ctrl+C)" Click="MenuCommentBlock_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💬⁺" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarUncomment" ToolTip="Descomentar Bloque Seleccionado (Ctrl+K, Ctrl+U)" Click="MenuUncommentBlock_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💬⁻" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnToolbarSwitchAssignment" ToolTip="Invertir Asignaciones A = B ⇄ B = A (Ctrl+Shift+R)" Click="MenuSwitchAssignment_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="⇄" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <ToggleButton x:Name="BtnToolbarToggleLineHighlight" ToolTip="Alternar Resaltado de Línea Activa" IsChecked="True" Click="BtnToolbarToggleLineHighlight_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="💡" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnToolbarToggleBranchLines" ToolTip="Alternar Guías de Estructura de Bloques (Branch Lines)" IsChecked="True" Click="BtnToolbarToggleBranchLines_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🌿" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                <ToggleButton x:Name="BtnToolbarToggleEndOfLineDetails" ToolTip="Alternar Detalles de Fin de Bloque (Inlay Hints)" IsChecked="True" Click="BtnToolbarToggleEndOfLineDetails_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🏷️" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </ToggleButton>
                <Separator/>
                <Menu Background="Transparent" VerticalAlignment="Center">
                    <MenuItem ToolTip="Cambiar Mayúsculas / Minúsculas" Header="🔤" Padding="4,2" FontSize="13">
                        <MenuItem Header="Convertir a MAYÚSCULAS" Click="MenuCaseUpper_Click"/>
                        <MenuItem Header="Convertir a minúsculas" Click="MenuCaseLower_Click"/>
                        <MenuItem Header="Convertir a Tipo Título" Click="MenuCaseTitle_Click"/>
                    </MenuItem>
                </Menu>
                <Separator/>
                <Button ToolTip="Alternar Marcador (Ctrl+F2)" Click="MenuToggleBookmark_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔖" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Siguiente Marcador (F2)" Click="MenuNextBookmark_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔖↓" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Marcador Anterior (Shift+F2)" Click="MenuPrevBookmark_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔖↑" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button ToolTip="Borrar Todos los Marcadores (Ctrl+Shift+F2)" Click="MenuClearBookmarks_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔖✕" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnToolbarPropertyBuilder" ToolTip="Asistente de Propiedades (Property Builder)" Click="MenuPropertyBuilder_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔧⁺" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarProcedureBuilder" ToolTip="Asistente de Procedimientos (Sub / Function Builder)" Click="MenuProcedureBuilder_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="⚡⁺" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarInsertSnippet" ToolTip="Insertar Snippet (AutoText)" Click="MenuInsertSnippet_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📑⁺" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarClipboardRing" ToolTip="Historial del Portapapeles (Ctrl+Shift+V)" Click="MenuClipboardRing_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📋°" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnToolbarFormatDocument" ToolTip="Formatear Documento (Ctrl+K, Ctrl+D)" Click="MenuFormatDocument_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🧹" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarSortProcedures" ToolTip="Ordenar Procedimientos del Módulo..." Click="MenuSortProcedures_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="↕" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                </Button>
                <Button x:Name="BtnToolbarShowDiff" ToolTip="Comparar Diferencias con el Disco (Diff)..." Click="MenuShowDiff_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="⚖️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarCodeStatistics" ToolTip="Estadísticas de Código y Métricas..." Click="MenuCodeStatistics_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="📊" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnToolbarErrorHandler" ToolTip="Gestor de Manejo de Errores (Error Handling Engine)..." Click="MenuErrorHandler_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🛡️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarTracing" ToolTip="Inyección y Retiro de Trazas (Tracing Subsystem)..." Click="MenuTracing_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="👣" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Separator/>
                <Button x:Name="BtnToolbarTabOrder" ToolTip="Diseñador de Orden de Tabulación (Tab Order)..." Click="MenuTabOrder_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🔢" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarHotkeys" ToolTip="Verificador de Teclas Rápidas (Hotkeys / Aceleradores)..." Click="MenuHotkeys_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="⌨️" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
                <Button x:Name="BtnToolbarCodeAnalyzer" ToolTip="Analizador de Calidad de Código (Code Analyzer)..." Click="MenuRunAnalysis_Click" Width="28" Height="24" Padding="0">
                    <TextBlock Text="🩺" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- 3. Área Principal: Panel Lateral + Splitter + Editor + Output Panel -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="RowOutputSplitter" Height="4"/>
                <RowDefinition x:Name="RowOutput" Height="140"/>
            </Grid.RowDefinitions>

            <!-- Área Superior: Toolbox + Editor + (Explorer & Properties) -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <!-- Columna 0: Caja de Herramientas (Toolbox de VB6) -->
                    <ColumnDefinition x:Name="ColToolbox" Width="135" MinWidth="32" MaxWidth="280"/>
                    <!-- Columna 1: Splitter Izquierdo -->
                    <ColumnDefinition x:Name="ColToolboxSplitter" Width="4"/>
                    <!-- Columna 2: Área Central de Documentos / Editor / Diseñador -->
                    <ColumnDefinition Width="*"/>
                    <!-- Columna 3: Splitter Derecho -->
                    <ColumnDefinition x:Name="ColRightSplitter" Width="4"/>
                    <!-- Columna 4: Panel Lateral Derecho (Explorador arriba, Propiedades abajo) -->
                    <ColumnDefinition x:Name="ColProjectExplorer" Width="280" MinWidth="180" MaxWidth="600"/>
                </Grid.ColumnDefinitions>

                <!-- Panel de Caja de Herramientas (Toolbox) -->
                <Border Grid.Column="0" Background="#F5F5F7" BorderBrush="#D0D0D0" BorderThickness="0,0,1,0">
                    <designer:ToolboxPanel x:Name="MainToolboxPanel"/>
                </Border>

                <!-- Splitter de Caja de Herramientas -->
                <GridSplitter x:Name="SplitterToolbox" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

                <!-- Área Central de Pestañas / Documentos -->
                <Border Grid.Column="2" Background="#ECECEC">
                    <Grid>
                        <TabControl x:Name="DocumentsTabControl" BorderThickness="0" Background="#FFFFFF">
                            <TabControl.ItemContainerStyle>
                                <Style TargetType="TabItem">
                                    <Setter Property="MinHeight" Value="28"/>
                                    <Setter Property="MinWidth" Value="110"/>
                                    <Setter Property="Padding" Value="10,4,8,4"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="TabItem">
                                                <Border x:Name="TabBorder" BorderThickness="1,1,1,0" BorderBrush="#D0D0D0" 
                                                        Background="#EDEDED" CornerRadius="4,4,0,0" Margin="2,2,2,0" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                      RecognizesAccessKey="True" ContentSource="Header"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#FFFFFF"/>
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#007ACC"/>
                                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,2,1,0"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#F8F8F8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TabControl.ItemContainerStyle>
                        </TabControl>

                        <!-- Mensaje cuando no hay documentos abiertos -->
                        <Border x:Name="EmptyDocsNotice" Background="#FDFDFD" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Visible">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="VB7-x64 IDE" FontSize="26" FontWeight="Bold" Foreground="#888888" HorizontalAlignment="Center"/>
                                <TextBlock Text="Abre un proyecto .vbp / grupo .vbg o archivo de código (.bas, .cls, .frm, .ctl, etc.)" FontSize="13" Foreground="#999999" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                                    <Button Content="Abrir Proyecto / Grupo (.vbp, .vbg)" Padding="10,5" Margin="5" Click="MenuOpenProject_Click"/>
                                    <Button Content="Abrir Archivo de Código VB6" Padding="10,5" Margin="5" Click="MenuOpenFile_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Splitter del Panel Derecho -->
                <GridSplitter x:Name="SplitterRight" Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeWE"/>

                <!-- Panel Lateral Derecho (Explorador arriba + Propiedades abajo) -->
                <Border Grid.Column="4" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- Fila 0: Explorador de Proyectos -->
                            <RowDefinition x:Name="RowProjectExplorer" Height="*"/>
                            <!-- Fila 1: Splitter horizontal -->
                            <RowDefinition x:Name="RowPropertiesSplitter" Height="4"/>
                            <!-- Fila 2: Ventana de Propiedades -->
                            <RowDefinition x:Name="RowProperties" Height="320" MinHeight="100"/>
                        </Grid.RowDefinitions>

                        <!-- Explorador de Proyectos en Fila 0 -->
                        <Grid Grid.Row="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" Background="#E8EEF5" BorderBrush="#C5D3E8" BorderThickness="0,0,0,1" Padding="6,4">
                                <DockPanel LastChildFill="True">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnViewCode" ToolTip="Ver Código (F7)" Width="22" Height="22" Margin="0,0,2,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnViewCode_Click">
                                            <TextBlock Text="📜" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="BtnViewObject" ToolTip="Ver Objeto / Diseñador (Shift+F7)" Width="22" Height="22" Margin="0,0,4,0" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnViewObject_Click">
                                            <TextBlock Text="🗔" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                        <Button x:Name="BtnToggleExplorerMode" ToolTip="Alternar Modo de Explorador (Estándar / Avanzado)" Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnToggleExplorerMode_Click">
                                            <TextBlock x:Name="TxtExplorerModeIcon" Text="⚡" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="Explorador de Proyectos" FontWeight="SemiBold" FontSize="12" Foreground="#102A45" VerticalAlignment="Center"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Row="1" Background="#F4F7FA" BorderBrush="#DCE4EC" BorderThickness="0,0,0,1" Padding="4,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" Foreground="#888888" VerticalAlignment="Center" Margin="2,0,4,0"/>
                                    <TextBox x:Name="TxtProjectSearch" Grid.Column="1" Height="22" FontSize="11.5" VerticalContentAlignment="Center" BorderThickness="1" BorderBrush="#C0CAD4" Padding="3,1" ToolTip="Buscar archivos, módulos o procedimientos en tiempo real" TextChanged="TxtProjectSearch_TextChanged"/>
                                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="18" Height="20" Margin="2,0,0,0" FontSize="10" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Limpiar búsqueda" Click="BtnClearSearch_Click" Visibility="Collapsed"/>
                                </Grid>
                            </Border>

                            <TreeView x:Name="ProjectTreeView" Grid.Row="2" BorderThickness="0" Padding="4" MouseDoubleClick="ProjectTreeView_MouseDoubleClick">
                                <TreeViewItem Header="Ningún proyecto abierto" IsSelected="True" Foreground="#777777" FontStyle="Italic"/>
                            </TreeView>
                        </Grid>

                        <!-- Splitter Horizontal entre Explorador y Propiedades -->
                        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeNS"/>

                        <!-- Ventana de Propiedades en Fila 2 -->
                        <designer:PropertyGridPanel x:Name="MainPropertyGridPanel" Grid.Row="2"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Splitter para el Panel Inferior de Salida -->
            <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#E0E0E0" Cursor="SizeNS"/>

            <!-- Panel Inferior Multiuso (Salida, Referencias, Lista de Tareas) -->
            <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabecera de Pestañas del Panel Inferior y botón de cierre -->
                    <Border Grid.Row="0" Background="#F0F0F0" BorderBrush="#D8D8D8" BorderThickness="0,0,0,1" Padding="4,2">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="✕" Width="18" Height="18" FontSize="10" Padding="0" Click="BtnCloseOutput_Click" ToolTip="Ocultar panel inferior"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabRadioOutput" Content="📋 Registro de Salida" GroupName="BottomPanelTabs" IsChecked="True"
                                             Style="{StaticResource BottomTabRadioStyle}" Click="BottomTabRadio_Click"/>
                                <RadioButton x:Name="TabRadioReferences" Content="🔍 Referencias y Usos" GroupName="BottomPanelTabs"
                                             Style="{StaticResource BottomTabRadioStyle}" Click="BottomTabRadio_Click"/>
                                <RadioButton x:Name="TabRadioTasks" Content="📝 Lista de Tareas (TODO)" GroupName="BottomPanelTabs"
                                             Style="{StaticResource BottomTabRadioStyle}" Click="BottomTabRadio_Click"/>
                                <RadioButton x:Name="TabRadioAnalysis" Content="🩺 Analizador de Código" GroupName="BottomPanelTabs"
                                             Style="{StaticResource BottomTabRadioStyle}" Click="BottomTabRadio_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Contenido de las pestañas -->
                    <Grid Grid.Row="1">
                        <!-- 1. Vista de Salida / Logs -->
                        <Grid x:Name="ViewOutput" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6,2">
                                <DockPanel>
                                    <TextBlock Text="Registro de eventos del IDE y compilación" FontSize="11" Foreground="#666666" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Limpiar" Padding="6,1" FontSize="11" Margin="0,0,4,0" Click="BtnClearOutput_Click"/>
                                        <Button Content="Abrir Carpeta" Padding="6,1" FontSize="11" Click="MenuOpenLogsFolder_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <TextBox x:Name="TxtOutputLog" Grid.Row="1" IsReadOnly="True" BorderThickness="0" Background="#FFFFFF"
                                     FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        </Grid>

                        <!-- 2. Vista de Referencias y Usos -->
                        <Grid x:Name="ViewReferences" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6,2">
                                <DockPanel>
                                    <TextBlock x:Name="TxtReferencesStatus" Text="No hay búsqueda activa. Coloca el cursor sobre un identificador y pulsa Shift+F12." FontSize="11" Foreground="#444444" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Buscar..." Padding="6,1" FontSize="11" Margin="0,0,4,0" Click="BtnSearchReferencesPrompt_Click"/>
                                        <Button Content="Limpiar" Padding="6,1" FontSize="11" Click="BtnClearReferences_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ListView x:Name="LstReferences" Grid.Row="1" BorderThickness="0" MouseDoubleClick="LstReferences_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Archivo" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Contenedor / Rutina" Width="170" DisplayMemberBinding="{Binding ContainerName}"/>
                                        <GridViewColumn Header="Línea" Width="55" DisplayMemberBinding="{Binding LineNumber}"/>
                                        <GridViewColumn Header="Tipo" Width="110" DisplayMemberBinding="{Binding DisplayType}"/>
                                        <GridViewColumn Header="Código coincidente" Width="450" DisplayMemberBinding="{Binding LineText}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!-- 3. Vista de Lista de Tareas (TODO Explorer) -->
                        <Grid x:Name="ViewTasks" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6,2">
                                <DockPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtTasksStatus" Text="0 tareas encontradas" FontSize="11" Foreground="#444444" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock Text="Filtro:" FontSize="11" Foreground="#666666" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="CmbTaskFilter" Width="100" Height="22" FontSize="11" SelectedIndex="0" SelectionChanged="CmbTaskFilter_SelectionChanged">
                                            <ComboBoxItem Content="Todas"/>
                                            <ComboBoxItem Content="TODO"/>
                                            <ComboBoxItem Content="FIXME"/>
                                            <ComboBoxItem Content="BUG"/>
                                            <ComboBoxItem Content="NOTE"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="🔄 Actualizar" Padding="6,1" FontSize="11" Click="BtnRefreshTasks_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ListView x:Name="LstTasks" Grid.Row="1" BorderThickness="0" MouseDoubleClick="LstTasks_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Pri." Width="50" DisplayMemberBinding="{Binding PriorityIcon}"/>
                                        <GridViewColumn Header="Etiqueta" Width="70" DisplayMemberBinding="{Binding Tag}"/>
                                        <GridViewColumn Header="Descripción" Width="360" DisplayMemberBinding="{Binding Description}"/>
                                        <GridViewColumn Header="Archivo" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Línea" Width="55" DisplayMemberBinding="{Binding LineNumber}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>

                        <!-- 4. Vista de Análisis de Calidad de Código -->
                        <Grid x:Name="ViewAnalysis" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#F7F7F7" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6,2">
                                <DockPanel>
                                    <TextBlock x:Name="TxtAnalysisStatus" Text="0 advertencias encontradas" FontSize="11" Foreground="#444444" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Analizar Proyecto / Archivo" Padding="6,1" FontSize="11" Margin="0,0,4,0" Click="BtnRunAnalysis_Click"/>
                                        <Button Content="Limpiar" Padding="6,1" FontSize="11" Click="BtnClearAnalysis_Click"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <ListView x:Name="LstAnalysis" Grid.Row="1" BorderThickness="0" MouseDoubleClick="LstAnalysis_MouseDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Severidad" Width="105" DisplayMemberBinding="{Binding DisplaySeverity}"/>
                                        <GridViewColumn Header="Regla" Width="190" DisplayMemberBinding="{Binding RuleId}"/>
                                        <GridViewColumn Header="Descripción / Advertencia" Width="400" DisplayMemberBinding="{Binding Message}"/>
                                        <GridViewColumn Header="Archivo" Width="140" DisplayMemberBinding="{Binding FileName}"/>
                                        <GridViewColumn Header="Línea" Width="55" DisplayMemberBinding="{Binding LineNumber}"/>
                                        <GridViewColumn Header="Miembro" Width="130" DisplayMemberBinding="{Binding ContainerName}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Barra de Estado Inferior -->
        <StatusBar x:Name="MainStatusBar" Grid.Row="3" Background="#F0F0F0" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="4,2">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem Grid.Column="0">
                <TextBlock x:Name="TxtStatusMessage" Text="Listo" FontSize="11.5" Foreground="#333333"/>
            </StatusBarItem>
            <Separator Grid.Column="1"/>
            <StatusBarItem Grid.Column="2">
                <TextBlock x:Name="TxtStatusLineCol" Text="Ln 1, Col 1" FontSize="11.5" Foreground="#555555" Margin="6,0"/>
            </StatusBarItem>
            <Separator Grid.Column="3"/>
            <StatusBarItem Grid.Column="4">
                <TextBlock x:Name="TxtStatusEncoding" Text="Windows-1252 (ANSI) | CRLF" FontSize="11.5" Foreground="#555555" Margin="6,0"/>
            </StatusBarItem>
            <Separator Grid.Column="5"/>
            <StatusBarItem Grid.Column="6">
                <TextBlock x:Name="TxtStatusPlatform" Text="Win-x64 | .NET 10" FontSize="11.5" FontWeight="SemiBold" Foreground="#004488" Margin="6,0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
