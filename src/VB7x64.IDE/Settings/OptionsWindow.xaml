<Window x:Class="VB7x64.IDE.Settings.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Opciones del Entorno"
        Height="360" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F4F4">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Editor">
                <StackPanel Margin="12">
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Fuente del Editor:" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="CmbFontFamily" Grid.Column="1" Height="24"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tamaño de Fuente:" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="CmbFontSize" Grid.Column="1" Height="24"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Tamaño de Tabulación:" VerticalAlignment="Center" FontSize="12"/>
                        <ComboBox x:Name="CmbTabSize" Grid.Column="1" Height="24"/>
                    </Grid>

                    <CheckBox x:Name="ChkLineNumbers" Content="Mostrar números de línea" Margin="0,5,0,8" FontSize="12"/>
                    <CheckBox x:Name="ChkCreateBak" Content="Crear copia de respaldo (.bak) al guardar" Margin="0,0,0,8" FontSize="12"/>
                </StackPanel>
            </TabItem>
            
            <TabItem Header="Codificación">
                <StackPanel Margin="12">
                    <TextBlock Text="Página de Códigos por Defecto:" FontWeight="SemiBold" Margin="0,0,0,8" FontSize="12"/>
                    <ComboBox x:Name="CmbEncoding" Height="24" Margin="0,0,0,12"/>
                    <TextBlock Text="Los archivos VB6 clásicos sin BOM se interpretan mediante la página de códigos ANSI de Windows (Windows-1252 o ACP del sistema) preservando acentos y caracteres especiales."
                               TextWrapping="Wrap" Foreground="#555555" FontSize="11.5"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Aceptar" Width="80" Height="26" Margin="0,0,8,0" IsDefault="True" Click="BtnOk_Click"/>
            <Button Content="Cancelar" Width="80" Height="26" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
