<Window x:Class="ViBa7.IDE.Dialogs.ComponentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Componentes"
        Height="570" Width="740"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F5F7"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="150"/>
        </Grid.ColumnDefinitions>

        <!-- Cuadro de Búsqueda Rápida y Filtro -->
        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8" Background="White" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="3" Padding="4,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="6,0,6,0" Foreground="#666666" FontSize="12"/>
                <TextBox x:Name="TxtSearch" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                         FontSize="12" TextChanged="TxtSearch_TextChanged" ToolTip="Escriba para filtrar por nombre, descripción o archivo"/>
                <Button x:Name="BtnClearSearch" Grid.Column="2" Content="✕" Width="20" Height="20" Background="Transparent" BorderThickness="0"
                        Foreground="#888888" Cursor="Hand" Click="BtnClearSearch_Click" ToolTip="Limpiar búsqueda"/>
            </Grid>
        </Border>

        <!-- Pestañas de Categoría: Controles OCX / DLLs ActiveX / Todos -->
        <TabControl x:Name="TabsCategory" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="0" Background="Transparent" Margin="0,0,0,6"
                    SelectionChanged="TabsCategory_SelectionChanged">
            <TabItem x:Name="TabControls" Header="Controles ActiveX (.ocx)" IsSelected="True" FontWeight="SemiBold"/>
            <TabItem x:Name="TabDlls" Header="DLLs ActiveX (.dll / .tlb)" FontWeight="SemiBold"/>
            <TabItem x:Name="TabAll" Header="Todos los Registrados" FontWeight="SemiBold"/>
        </TabControl>

        <!-- Contenido principal: Lista de controles y DLLs con CheckBox -->
        <Grid Grid.Row="2" Grid.Column="0">
            <Border Background="#FFFFFF" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="3">
                <ListBox x:Name="LstComponents" BorderThickness="0" SelectionMode="Single"
                         SelectionChanged="LstComponents_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- CheckBox para vincular al proyecto activo -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="2,0,8,0"
                                          ToolTip="Marcar para cargar al proyecto activo y toolbox"/>
                                <!-- Icono distintivo -->
                                <TextBlock Grid.Column="1" Text="{Binding TypeBadgeIcon}" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <!-- Textos: Título principal y detalle de archivo -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" FontSize="12" FontWeight="SemiBold" Foreground="#111827"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#6B7280" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Overlay de carga en segundo plano -->
            <Border x:Name="PnlLoading" Background="#CCFFFFFF" CornerRadius="3" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="140" Height="6" Margin="0,0,0,8"/>
                    <TextBlock Text="Cargando componentes del sistema..." FontSize="11.5" Foreground="#4B5563" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Botones Laterales -->
        <StackPanel Grid.Row="2" Grid.Column="1" Margin="12,0,0,0">
            <Button x:Name="BtnOk" Content="Aceptar" Height="28" Margin="0,0,0,6" IsDefault="True" FontWeight="SemiBold" Click="BtnOk_Click"/>
            <Button x:Name="BtnCancel" Content="Cancelar" Height="26" Margin="0,0,0,10" IsCancel="True" Click="BtnCancel_Click"/>
            
            <Separator Margin="0,2,0,8" Background="#E5E7EB"/>
            
            <Button x:Name="BtnBrowse" Content="Examinar..." Height="28" Margin="0,0,0,8" Click="BtnBrowse_Click"
                    ToolTip="Buscar un archivo .ocx, .dll o .tlb en disco, autoregistrarlo en Windows y agregarlo"/>
            
            <Button x:Name="BtnSelectAll" Content="Marcar visibles" Height="24" Margin="0,0,0,5" Click="BtnSelectAll_Click"/>
            <Button x:Name="BtnDeselectAll" Content="Desmarcar visibles" Height="24" Margin="0,0,0,12" Click="BtnDeselectAll_Click"/>
            
            <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="3" Padding="6">
                <StackPanel>
                    <TextBlock x:Name="TxtStatusTotal" Text="Total: 0" FontSize="11" Foreground="#4B5563"/>
                    <TextBlock x:Name="TxtStatusSelected" Text="Seleccionados: 0" FontSize="11" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Panel Inferior de Detalles del Componente Seleccionado -->
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0" Padding="10" Background="#F9FAFB" BorderBrush="#D0D5DD" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Archivo:" FontWeight="Bold" FontSize="11" Foreground="#4B5563"/>
                <TextBlock x:Name="TxtFilePath" Grid.Row="0" Grid.Column="1" Text="(Ninguno)" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#111827"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Biblioteca:" FontWeight="Bold" FontSize="11" Foreground="#4B5563" Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtLibrary" Grid.Row="1" Grid.Column="1" Text="-" FontSize="11" Foreground="#111827" Margin="0,3,0,0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Controles:" FontWeight="Bold" FontSize="11" Foreground="#4B5563" Margin="0,3,0,0"/>
                <TextBlock x:Name="TxtControls" Grid.Row="2" Grid.Column="1" Text="-" FontSize="11" Foreground="#004488" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
