<Window x:Class="ViBa7.IDE.Dialogs.ErrorHandlerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestor de Esquemas de Manejo de Errores"
        Height="580" Width="840"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F4">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <TextBlock Grid.Row="0" Text="Configura e inserta bloques estructurados de captura de excepciones en tus procedimientos:" 
                   FontSize="12.5" FontWeight="SemiBold" Foreground="#004488" Margin="0,0,0,8"/>

        <!-- Panel de Configuración del Esquema -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna 1: Selección y Opciones de Ámbito -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Esquema de Manejo de Errores:" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbSchemes" Height="25" Margin="0,0,0,8" SelectionChanged="CmbSchemes_SelectionChanged"/>

                    <TextBlock x:Name="TxtSchemeDesc" Text="Descripción del esquema..." FontSize="11" Foreground="#555555" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <Separator Margin="0,4,0,8"/>

                    <TextBlock Text="Ámbito de Aplicación:" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4"/>
                    <RadioButton x:Name="RbAllProcs" Content="Todos los procedimientos del módulo actual" IsChecked="True" Checked="Option_Changed" Margin="0,0,0,4"/>
                    <RadioButton x:Name="RbCurrentProc" Content="Solo el procedimiento en el cursor" Checked="Option_Changed" Margin="0,0,0,6"/>

                    <CheckBox x:Name="ChkOverwriteExisting" Content="Sobrescribir rutinas que ya tengan 'On Error'" IsChecked="False" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Columna 2: Plantillas de Código del Esquema -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Sentencia de Apertura (Header):" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtHeaderStatement" FontFamily="Consolas" FontSize="11.5" Height="24" Margin="0,0,0,6" TextChanged="Template_TextChanged"/>

                    <TextBlock Text="Bloque Manejador de Error (ErrorHandler):" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtHandlerBlock" FontFamily="Consolas" FontSize="11" Height="80" TextWrapping="NoWrap" AcceptsReturn="True" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="Template_TextChanged"/>
                    
                    <TextBlock Text="Macros: %PROC_NAME%, %MODULE_NAME%, %EXIT_TYPE%, %DATE%, %USER%" FontSize="10.5" Foreground="#777777" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vista Previa del Código Resultante -->
        <GroupBox Grid.Row="2" Header="Vista Previa en Tiempo Real" Background="#FFFFFF" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtPreview" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="8" TextWrapping="NoWrap" AcceptsReturn="True"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Botones de Acción -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="BtnRemove" Content="🗑️ Retirar Manejo de Errores" Width="190" Height="26" DockPanel.Dock="Left" Click="BtnRemove_Click" ToolTip="Elimina los bloques On Error y ErrorHandler del ámbito seleccionado."/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnApply" Content="🛡️ Aplicar Manejo de Errores" Width="190" Height="26" Margin="0,0,8,0" IsDefault="True" Click="BtnApply_Click"/>
                <Button Content="Cancelar" Width="80" Height="26" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
