<Window x:Class="ViBa7.IDE.Dialogs.TracingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inyección y Retiro de Trazas de Ejecución (Tracing Subsystem)"
        Height="560" Width="840"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F4F4F4">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->
        <TextBlock Grid.Row="0" Text="Inserta o retira automáticamente sentencias de registro y seguimiento al inicio y fin de cada rutina:" 
                   FontSize="12.5" FontWeight="SemiBold" Foreground="#004488" Margin="0,0,0,8"/>

        <!-- Panel de Configuración de Trazas -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Columna 1: Ámbito y Etiqueta -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ámbito de Aplicación:" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,4"/>
                    <RadioButton x:Name="RbAllProcs" Content="Todos los procedimientos del módulo actual" IsChecked="True" Checked="Option_Changed" Margin="0,0,0,4"/>
                    <RadioButton x:Name="RbCurrentProc" Content="Solo el procedimiento en el cursor" Checked="Option_Changed" Margin="0,0,0,8"/>

                    <CheckBox x:Name="ChkInjectExit" Content="Inyectar traza de salida antes de Exit / End" IsChecked="True" Checked="Option_Changed" Unchecked="Option_Changed" Margin="0,0,0,8"/>

                    <Separator Margin="0,2,0,8"/>

                    <TextBlock Text="Etiqueta Identificadora de Trazas:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtTraceTag" Text="' [VB7_TRACE]" FontSize="11" Height="24" TextChanged="Template_TextChanged"/>
                    <TextBlock Text="* Esta etiqueta permite remover las trazas automáticamente antes de compilar sin afectar otros logs del usuario." 
                               FontSize="10.5" Foreground="#777777" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Columna 2: Plantillas de Traza -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Plantilla de Traza de Entrada (Entry Trace):" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtEntryTemplate" FontFamily="Consolas" FontSize="11" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                             TextChanged="Template_TextChanged" Margin="0,0,0,8"/>

                    <TextBlock Text="Plantilla de Traza de Salida (Exit Trace):" FontWeight="SemiBold" FontSize="11.5" Margin="0,0,0,2"/>
                    <TextBox x:Name="TxtExitTemplate" FontFamily="Consolas" FontSize="11" Height="50" TextWrapping="Wrap" AcceptsReturn="True" 
                             TextChanged="Template_TextChanged" Margin="0,0,0,4"/>

                    <TextBlock Text="Macros disponibles: %PROC_NAME%, %MODULE_NAME%, %DATE%, %USER%" FontSize="10.5" Foreground="#777777"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Vista Previa del Código Resultante -->
        <GroupBox Grid.Row="2" Header="Vista Previa en Tiempo Real" Background="#FFFFFF" Margin="0,0,0,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtPreview" FontFamily="Consolas" FontSize="11.5" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="8" TextWrapping="NoWrap" AcceptsReturn="True"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Botones de Acción -->
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button x:Name="BtnRemove" Content="🗑️ Retirar Todas las Trazas" Width="180" Height="26" DockPanel.Dock="Left" Click="BtnRemove_Click" ToolTip="Elimina las líneas de traza inyectadas con la etiqueta especificada."/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnApply" Content="👣 Inyectar Trazas" Width="160" Height="26" Margin="0,0,8,0" IsDefault="True" Click="BtnApply_Click"/>
                <Button Content="Cancelar" Width="80" Height="26" IsCancel="True"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
